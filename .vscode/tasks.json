{
	// See http://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"command": "tsc",
	"args": [
		"-p",
		"."
	],
	"problemMatcher": "$tsc",
	"tasks": [
		{
			"label": "tsc-unit-tests",
			"type": "shell",
			"command": "./node_modules/.bin/tsc",
			"args": [
				"-p",
				"tsconfig.unit-tests.json"
			],
			"problemMatcher": "$tsc"
		},
		{
			"label": "unit-tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"unit-test"
			]
		},
		{
			"label": "unit-tests-watch",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"unit-test-watch"
			]
		}
	]
}